# ollama endpoint: http://localhost:11434 on host, http://ollama:11434 inside docker
OLLAMA_BASE_URL=http://localhost:11434

# target model tag (use gemma4:e2b if you're low on ram)
MODEL_NAME=gemma4:e4b

# web interface host and port
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# max image dimension in px before passing to model (downscaling speeds up inference)
IMAGE_MAX_SIZE=1024

# timeout in seconds for ollama api response
REQUEST_TIMEOUT=180

# return canned demo answers if ollama is offline or model is still downloading
DEMO_FALLBACK=true
