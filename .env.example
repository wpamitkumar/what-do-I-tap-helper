# Ollama API Configuration
# When running locally on host machine: http://localhost:11434
# When running inside Docker Compose: http://ollama:11434
# When container connects to Ollama on host Mac: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Multimodal Model tag in Ollama
# Default recommended: gemma4:e4b (or gemma4:e2b if low on RAM)
MODEL_NAME=gemma4:e4b

# Gradio Server configuration
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Max resolution for image resize before sending to model (smaller = faster)
IMAGE_MAX_SIZE=1024

# Timeout for Ollama requests in seconds
REQUEST_TIMEOUT=180

# Demo fallback mode: provides instant demo responses if Ollama is offline or model still loading
DEMO_FALLBACK=true
